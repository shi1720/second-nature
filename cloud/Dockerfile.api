FROM python:3.11-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PORT=8080
WORKDIR /app
COPY cloud/requirements.txt /app/cloud/requirements.txt
RUN pip install --no-cache-dir -r /app/cloud/requirements.txt && useradd --uid 10001 --create-home studio
COPY cloud/*.py /app/cloud/
USER 10001
CMD ["uvicorn","cloud.api:app","--host","0.0.0.0","--port","8080","--workers","1","--proxy-headers"]
